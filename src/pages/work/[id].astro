---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const entries = await getCollection('work', ({ data }) => import.meta.env.DEV || !data.draft);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<Base title={d.title} description={d.summary}>
  <a href="/#work" class="text-sm text-muted hover:text-ink">← All work</a>
  <article class="mt-8">
    <h1 class="text-4xl font-semibold leading-tight tracking-tight">{d.title}</h1>
    <p class="mt-3 text-muted">{d.company} · {d.role} · {d.period}</p>
    <div class="prose prose-lg mt-10 max-w-none prose-headings:tracking-tight prose-a:text-accent">
      <Content />
    </div>
  </article>
</Base>
